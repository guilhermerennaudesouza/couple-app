rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions for Firebase Storage authentication and content verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCoupleMember(coupleId) {
      return isAuthenticated() &&
        request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.members;
    }

    function isValidImage() {
      return request.resource == null || (
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*')
      );
    }

    // Couple shared photo storage (memories, profile avatars, time capsule photos)
    match /couples/{coupleId}/photos/{allPaths=**} {
      allow read: if isCoupleMember(coupleId);
      allow write: if isCoupleMember(coupleId) && isValidImage();
    }
  }
}
