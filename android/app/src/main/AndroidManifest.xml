<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.personal.couple_app">

    <!-- Local Notifications & Exact Alarm Permissions (Android 13/14+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- Flutter v2 Embedding Declaration -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Main Flutter Activity (Launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Jetpack Glance Sticky Note Widget Receiver -->
        <receiver
            android:name=".NoteGlanceWidget"
            android:label="@string/note_glance_widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/note_glance_widget_info" />
        </receiver>

        <!-- Jetpack Glance Days Together Widget Receiver -->
        <receiver
            android:name=".CoupleGlanceWidget"
            android:label="@string/couple_glance_widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/couple_glance_widget_info" />
        </receiver>

        <!-- Jetpack Glance Daily Prompt Widget Receiver -->
        <receiver
            android:name=".DailyPromptGlanceWidget"
            android:label="@string/daily_prompt_glance_widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_prompt_glance_widget_info" />
        </receiver>

        <!-- Jetpack Glance Shared Tasks Widget Receiver -->
        <receiver
            android:name=".TasksGlanceWidget"
            android:label="@string/tasks_glance_widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_glance_widget_info" />
        </receiver>

    </application>
</manifest>
